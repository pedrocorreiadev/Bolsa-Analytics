# Configuração para execução local sem Docker.
# No Docker, docker compose up --build -d funciona sem criar este arquivo.
# Copie este arquivo para .env na raiz antes de executar os comandos locais do README.
# O backend lê o arquivo quando iniciado com --env-file ../.env.
# Origem única autorizada pelo CORS; sem barra final.
FRONTEND_ORIGIN=http://localhost:5173

# Endereço utilizado pelos serviços HTTP do frontend no desenvolvimento local.
# O Vite lê o .env da raiz via envDir. Variáveis VITE_* são públicas no navegador.
VITE_API_BASE_URL=http://127.0.0.1:8000
