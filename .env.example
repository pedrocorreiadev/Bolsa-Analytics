# Configuração para execução local sem Docker.
# No Docker, docker compose up --build -d funciona sem criar este arquivo.
# Copie este arquivo para .env na raiz antes de executar os comandos locais do README.
# O backend lê o arquivo quando iniciado com --env-file ../.env.
# Origem única autorizada pelo CORS; sem barra final.
FRONTEND_ORIGIN=http://localhost:5173

# O navegador chama /api na mesma origem para preservar a sessão HttpOnly.
# O proxy do Vite/preview encaminha as requisições ao endereço abaixo.
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/

# SQLite é criado automaticamente em backend/data/bolsa.sqlite3.
# BOLSA_DB_PATH pode definir outro caminho gravável, apenas no backend.
# Em hospedagem HTTPS, defina true para exigir transporte seguro do cookie.
BOLSA_COOKIE_SECURE=false
